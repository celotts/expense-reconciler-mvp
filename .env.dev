PROJECT_NAME="Expense Reconciler MVP"
DATABASE_URL=postgresql+asyncpg://postgres:fc100711@postgres-reconciler:5432/expense_db
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ============================================
# AI / LLM Configuration
# ============================================
AI_ENABLED=true

# --- Ollama (Local) ---
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
# Otras opciones: llama3.1:70b, mistral:7b, codellama:13b, phi3:mini

# --- OpenAI (Cloud) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure OpenAI (Enterprise) ---
# AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com/
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Local Embeddings (fallback gratis) ---
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- AI Processing ---
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.1
EMBEDDING_DIMENSIONS=1536
SIMILARITY_THRESHOLD=0.85