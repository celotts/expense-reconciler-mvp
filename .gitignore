# Database
*.sqlite
*.db

# El .gitignore global de este equipo ignora *.sql, pero el esquema y las
# migraciones SI son parte del proyecto. Sin db/init.sql no hay forma de
# levantar el stack en una maquina nueva, y sin db/migrations/ no hay forma de
# actualizar una base que ya existe. Se versionan a proposito.
!db/
!db/**/*.sql

# Frontend
front/node_modules/
front/dist/
front/build/
front/.vite/
front/*.local

# Docker
.docker/

# Test files
test-files/*.pdf
!test-files/factura_gas.txt
!test-files/movimientos_banco.csv

# Temporary files
*.tmp
*.temp
/tmp/

# Jupyter Notebook
.ipynb_checkpoints

# Environment files
# Estos NUNCA se versionan: contienen SECRET_KEY y el password de la base.
# La plantilla que si se versiona es .env.example
.env
.env.local
.env.*.local
.env.dev
.env.*.dev
!.env.example

# IDE specific
*.sublime-project
*.sublime-workspace