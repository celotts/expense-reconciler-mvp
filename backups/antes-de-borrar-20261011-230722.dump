--
-- Name: idx_bank_tx_amount; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX idx_bank_tx_amount ON public.bank_transactions USING btree (amount);


--
-- Name: idx_bank_tx_date; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX idx_bank_tx_date ON public.bank_transactions USING btree (transaction_date);


--
-- Name: idx_tickets_date; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX idx_tickets_date ON public.tickets USING btree (expense_date);


--
-- Name: ix_cierres_periodo_unico; Type: INDEX; Schema: public; Owner: postgres
--

CREATE UNIQUE INDEX ix_cierres_periodo_unico ON public.cierres_periodo USING btree (company_id, periodo);


--
-- Name: ix_compra_items_compra; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_compra_items_compra ON public.compra_items USING btree (compra_id);


--
-- Name: ix_compra_items_impuestos; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_compra_items_impuestos ON public.compra_items USING btree (compra_id) WHERE ((ieps_linea IS NOT NULL) OR (iva_linea IS NOT NULL));


--
-- Name: ix_compra_items_producto; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_compra_items_producto ON public.compra_items USING btree (producto_id) WHERE (producto_id IS NOT NULL);


--
-- Name: ix_compra_items_sin_producto; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_compra_items_sin_producto ON public.compra_items USING btree (compra_id) WHERE (producto_id IS NULL);


--
-- Name: ix_compras_empresa_estado; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_compras_empresa_estado ON public.compras USING btree (company_id, estado);


--
-- Name: ix_compras_fecha; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_compras_fecha ON public.compras USING btree (fecha);


--
-- Name: ix_movimientos_producto; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_movimientos_producto ON public.movimientos_inventario USING btree (company_id, producto_id, created_at);


--
-- Name: ix_movimientos_referencia; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_movimientos_referencia ON public.movimientos_inventario USING btree (referencia_tipo, referencia_id);


--
-- Name: ix_productos_codigo; Type: INDEX; Schema: public; Owner: postgres
--

CREATE UNIQUE INDEX ix_productos_codigo ON public.productos USING btree (company_id, codigo) WHERE (codigo IS NOT NULL);


--
-- Name: ix_productos_empresa; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_productos_empresa ON public.productos USING btree (company_id, activo);


--
-- Name: ix_productos_nombre; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_productos_nombre ON public.productos USING btree (company_id, lower((nombre)::text));


--
-- Name: ix_productos_nombre_normalizado; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_productos_nombre_normalizado ON public.productos USING btree (company_id, nombre_normalizado);


--
-- Name: ix_productos_sin_verificar; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_productos_sin_verificar ON public.productos USING btree (company_id, created_at) WHERE (verificado = false);


--
-- Name: ix_reconciliations_revisadas; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_reconciliations_revisadas ON public.reconciliations USING btree (revisado_at DESC) WHERE (revisado_por IS NOT NULL);


--
-- Name: ix_scan_events_file_created; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_scan_events_file_created ON public.scan_events USING btree (scan_file_id, created_at);


--
-- Name: ix_scan_files_company; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_scan_files_company ON public.scan_files USING btree (company_id, status);


--
-- Name: ix_scan_files_content_hash; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_scan_files_content_hash ON public.scan_files USING btree (content_hash);


--
-- Name: ix_scan_files_status; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_scan_files_status ON public.scan_files USING btree (status);


--
-- Name: ix_ticket_documents_cadena; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_ticket_documents_cadena ON public.ticket_documents USING btree (ticket_id, version);


--
-- Name: ix_ticket_documents_sin_bifurcar; Type: INDEX; Schema: public; Owner: postgres
--

CREATE UNIQUE INDEX ix_ticket_documents_sin_bifurcar ON public.ticket_documents USING btree (reemplaza_a) WHERE (reemplaza_a IS NOT NULL);


--
-- Name: ix_ticket_documents_ticket; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_ticket_documents_ticket ON public.ticket_documents USING btree (ticket_id);


--
-- Name: ix_tickets_review_queue; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_tickets_review_queue ON public.tickets USING btree (extraction_status, company_id) WHERE ((extraction_status)::text = ANY ((ARRAY['REQUIERE_REVISION'::character varying, 'PENDIENTE'::character varying])::text[]));


--
-- Name: ix_tickets_source_hash; Type: INDEX; Schema: public; Owner: postgres
--

CREATE UNIQUE INDEX ix_tickets_source_hash ON public.tickets USING btree (company_id, source_hash) WHERE (source_hash IS NOT NULL);


--
-- Name: ix_tickets_spot_check_queue; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_tickets_spot_check_queue ON public.tickets USING btree (company_id, created_at) WHERE ((spot_check_status)::text = 'PENDIENTE'::text);


--
-- Name: ix_tickets_spot_check_report; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_tickets_spot_check_report ON public.tickets USING btree (company_id, confidence_source) WHERE (spot_check_status IS NOT NULL);


--
-- Name: ix_users_activos; Type: INDEX; Schema: public; Owner: postgres
--

CREATE INDEX ix_users_activos ON public.users USING btree (lower((email)::text)) WHERE is_active;


--
