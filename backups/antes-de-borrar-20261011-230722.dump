    subtotal numeric(12,2),
    items jsonb,
    ieps_amount numeric(12,2),
    CONSTRAINT ck_tickets_spot_check_only_auto CHECK (((spot_check_status IS NULL) OR ((extraction_status)::text = 'AUTO_APROBADO'::text))),
