    CONSTRAINT ck_tickets_spot_check_verdict_has_date CHECK (((spot_check_status IS NULL) OR ((spot_check_status)::text = 'PENDIENTE'::text) OR (spot_checked_at IS NOT NULL))),
    CONSTRAINT ck_tickets_tax_lte_total_when_settled CHECK ((((extraction_status)::text <> ALL ((ARRAY['AUTO_APROBADO'::character varying, 'APROBADO'::character varying])::text[])) OR (tax_amount <= total_amount))),
    CONSTRAINT ck_tickets_tax_non_negative_when_settled CHECK ((((extraction_status)::text <> ALL ((ARRAY['AUTO_APROBADO'::character varying, 'APROBADO'::character varying])::text[])) OR (tax_amount >= (0)::numeric))),
    CONSTRAINT ck_tickets_total_positive_when_settled CHECK ((((extraction_status)::text <> ALL ((ARRAY['AUTO_APROBADO'::character varying, 'APROBADO'::character varying])::text[])) OR (total_amount > (0)::numeric)))
);


