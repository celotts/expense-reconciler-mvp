# Este es el ARCHIVO PLANTILLA: la unica de la familia que se versiona.
# Los otros dos son locales y estan en `.gitignore`:
#
#   .env        -> la configuracion de la app (IA, carpeta de tickets, OCR) Y la
#                  contrasena de la base. Lo leen `docker compose` y
#                  `app/core/config.py`. chmod 600.
#   .env.local  -> solo SECRET_KEY, y solo si quieres que sobreviva a los
#                  reinicios de `--reload`. Gana sobre `.env`. chmod 600.
#
# DOS ARCHIVOS, Y POR QUE NO UNO
# ------------------------------
#
# Todo lo demas va en `.env`, incluida la contrasena de la base. Lo unico que se
# queda fuera es la `SECRET_KEY`, y es por una razon concreta: con ella se firman
# tokens validos sin pasar por el login. Si estuviera en `.env`, compartir la
# configuracion de IA con otra persona significaria compartir la clave, porque
# los dos viajan en el mismo archivo.
#
# La app lee `.env` y despues `.env.local`, en ese orden y con el ultimo
# ganando, que es el mismo orden que usa `docker-compose.yml`. Correr `uvicorn`
# a mano firma los tokens con la misma clave que el contenedor.
#
#     cp .env.example .env
#     chmod 600 .env
#
# Si alguna vez versionaste un secreto, rotalo: cambiar el archivo no borra el
# historial.

# --- Base de datos ------------------------------------------------------------
# La leen `docker-compose.yml` (postgres y api) y la app. Sin ella el compose se
# niega a arrancar con un error explicito, en vez de levantar un postgres con una
# password vacia.
POSTGRES_PASSWORD=CAMBIAR_ESTA_PASSWORD
# Dentro de Docker el host es el nombre del servicio: postgres-reconciler, y la
# contrasena la pone `docker-compose.yml`. Esta linea es para correr la app FUERA
# de Docker, apuntando a una base que exista de verdad.
# Fuera de Docker (con la BD en tu maquina): localhost:5432
# SIN contrasena, aunque la de mas arriba si la tenga. Dentro de Docker la
# sobrescribe `docker-compose.yml` en su `environment:`, y ahi es donde se
# arma la URL con `${POSTGRES_PASSWORD}`. Ese es el UNICO lugar del proyecto
# donde existe una URL con contrasena; duplicarla aqui seria el mismo secreto
# en dos lineas del mismo archivo.
#
# Para correr la app FUERA de Docker hay que rellenar la contrasena en esta
# linea, o exportar `DATABASE_URL` con ella antes de levantar `uvicorn`.
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/expense_db

# --- API ----------------------------------------------------------------------
PROJECT_NAME="Expense Reconciler MVP"
API_V1_STR="/api/v1"
# Sin comodines. Con `*` la app NO ARRANCA: `allow_credentials=True` mas un
# origen comodin hace que cualquier sitio web lea la API con la sesion del
# navegador de quien la tiene abierta. Ver el test de arranque en
# tests/unit/test_config_secrets.py.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Autenticacion (OBLIGATORIO) ---------------------------------------------
# development | production
ENVIRONMENT=development

# Sin esta, en development se genera una clave efimera y TODOS los tokens se
# invalidan en cada reinicio. En production el arranque FALLA a proposito.
# Minimo 32 caracteres. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIAR_ESTA_POR_UNA_LARGA_ALEATORIA_DE_48_CARACTERES

ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- IA ----------------------------------------------------------------------
AI_ENABLED=true

# Ollama (local). Requiere OLLAMA_ENABLED=true y el servicio levantado.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=moondream
OLLAMA_TIMEOUT=600.0

# Proveedor en la nube. Opcionales: si no hay ninguno, el pipeline degrada en
# silencio a "guarda lo parcial" (tickets con importe 0.00 y sin error visible).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Embeddings ---------------------------------------------------------------
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=1536
SIMILARITY_THRESHOLD=0.85

# --- Procesamiento IA ---------------------------------------------------------
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.1

# --- Escaner de carpeta -------------------------------------------------------
# La carpeta de la que se leen los comprobantes. Es la UNICA ruta que el escaner
# conoce: no hay endpoint ni parametro que acepte otra, a proposito, porque un
# escaner que acepta una carpeta del cliente es lectura arbitraria del disco del
# servidor. Ver la nota de seguridad en app/services/scan_service.py.
#
# El valor por omision esta en el codigo, asi que si no defines nada el escaneo
# funciona igual. Se documenta aqui para que quede a la vista.
#
# # Las dos carpetas del escaner son HERMANAS bajo `Documents/Tickets/`:
# `Tickets/Tickets_app` (esta, la de entrada) y `Tickets/Tickets_Scan` (la de
# los ya digitalizados). Con esa hermandad, `TICKETS_SCAN_OUTPUT_DIR` vacia acierta
# solo: `archivado_service` resuelve "el hermano de la entrada".
#
# El padre comun no es estetica: deja las dos carpetas juntas y arrastrables como
# una unidad, y separadas de cualquier otra carpeta de papel de `Documents`.
# Y NO se pueden anidar: `Tickets_Scan` colgando de `Tickets_app` hace que el
# escaneo recursivo vuelva a leer lo archivado en cada corrida.
TICKETS_INPUT_DIR=/Users/carloslott/Documents/Tickets/Tickets_app

# Crear la carpeta si no existe. Con `false`, la app NO arranca si la carpeta no
# esta. Con `true` (por omision) la crea, porque la primera vez que alguien usa
# esto la carpeta no existe todavia y no es un error.
TICKETS_INPUT_DIR_AUTOCREAR=true

# Con Docker, la ruta en TU maquina: la lee `docker-compose.yml` para saber que
# montar en `/tickets`. Se separa de `TICKETS_INPUT_DIR` a proposito, porque son
# dos cosas distintas: una es la ruta del host y la otra la que ve la app dentro
# del contenedor. Si fueran una, habria que cambiarla cada vez que se alterna
# entre Docker y Python directo, y con el valor mal puesto la app buscaria
# `/Users/...` dentro del contenedor, donde no existe.
TICKETS_HOST_DIR=/Users/carloslott/Documents/Tickets/Tickets_app

# Bajar a subcarpetas. Un comprobante de un viaje esta en `viaje/2025/03/`, y un
# escaner de un solo nivel no lo veria nunca.
TICKETS_SCAN_RECURSIVO=true

# Tope por corrida. Si la carpeta tiene mas archivos, el escaneo procesa estos y
# el siguiente `POST /api/v1/scan/` sigue con los que faltan. Sin este tope, la
# primera vez que se escanean 3000 comprobantes la peticion dura minutos y
# probablemente revienta un proxy.
TICKETS_SCAN_MAX_ARCHIVOS=200

# Tope por archivo. Cada archivo se lee entero para hashearlo, asi que un video
# de 2 GB en la carpeta se come la memoria del proceso, que es el mismo proceso
# que sirve el resto de la API.
TICKETS_SCAN_MAX_BYTES=26214400

# --- Archivado ----------------------------------------------------------------
#
# Un comprobante NO se borra: se mueve a la carpeta de escaneados y sigue
# existiendo con los mismos bytes. Es lo que permite una auditoria sin depender
# de que el sistema no haya mentido.
#
# Y se mueve cuando el sistema ya lo digitalizo, NO cuando la lectura fue buena.
# La carpeta de escaneados no significa "esto se leyo bien", significa "esto ya
# se intento y su veredicto quedo escrito" en `tickets.extraction_status`. Con el
# OCR al 33.3% eso es frecuente, y por eso la respuesta del escaneo trae
# `archivados_pendientes`: el numero de los que se movieron sin leerse bien.
# visible es una decision; escondido seria un error.
#
# Con Docker, esta es la ruta DENTRO del contenedor. La del host va en
# TICKETS_SCAN_OUTPUT_HOST_DIR y la monta docker-compose.yml.
#
# VACIA = "una carpeta hermana de TICKETS_INPUT_DIR". Es la omision que funciona
# fuera de Docker: una ruta de contenedor como `/tickets_scan` da "Read-only file
# system" en macOS.
TICKETS_SCAN_OUTPUT_DIR=

# La carpeta de escaneados EN TU MAQUINA. HERMANA de la de entrada —las dos
# viven bajo `Documents/Tickets/`— y no una subcarpeta DENTRO de ella, a proposito:
# con TICKETS_SCAN_RECURSIVO=true, una subcarpeta haria que cada archivo movido se
# volviera a leer en cada corrida, porque su `relative_path` cambia y el ledger no
# lo reconoce. Sibling, no hijo.
TICKETS_SCAN_OUTPUT_HOST_DIR=/Users/carloslott/Documents/Tickets/Tickets_Scan

# Mover al digitalizar (true) o esperar a que alguien confirme la compra (false).
#
# Los dos caminos existen y no son lo mismo:
# - true: la carpeta de entrada queda como bandeja real. Lo que hay ahi es lo que
#   NO se ha digitalizado todavia.
# - false: mas seguro —solo se mueve lo que una persona autorizo— y la entrada se
#   llena de papel ya resuelto que hay que distinguir a ojo.
TICKETS_SCAN_ARCHIVAR_AL_ESCANEAR=true
TICKETS_SCAN_ARCHIVAR_AL_CONFIRMAR=true

# Apagar el archivado entero sin tocar la ruta. Con false, nada se mueve y cada
# comprobante se queda donde estaba.
TICKETS_SCAN_ARCHIVAR=true

# --- OCR local ----------------------------------------------------------------
# El escaner NO depende de ninguna API de pago. Con esto apagado, un PDF con
# texto y un PDF escaneado se leen igual; lo unico que se pierde es la foto
# borrosa que solo vision podria descifrar.
#
# `OCR_ENABLED=false` manda las fotos directo al modelo de vision. Conviene
# apagarlo solo para comparar: con OCR, una foto buena no cuesta nada y queda
# registrada como `ocr`, que es la verdad sobre quien leyo el papel.
OCR_ENABLED=true

# Idiomas que se le piden a Tesseract. `spa` es el que hace falta para un
# comprobante mexicano; `eng` esta porque los tickets de tiendas y gasolineras
# mezclan ingles.
#
# Para cambiarlo hay que tener el paquete instalado. En macOS:
# `brew install tesseract tesseract-lang`. En Debian, el Dockerfile ya instala
# `spa` y `eng`.
OCR_IDIOMA=spa+eng

# Modo de segmentacion de Tesseract. 6 = "un bloque de texto uniforme", que es lo
# que es un ticket. No lo cambies sin leer la documentacion de Tesseract: 3
# (automatico) es peor con papel pequeno alineado a la izquierda, y 11 (sparse)
# esta pensado para capturas de pantalla, no para fotos de papel.
OCR_PSM=6

# ============================================================================
# AVISO: si subes OLLAMA_MODEL u OLLAMA_VISION_MODEL a uno que no este descargado,
# Ollama devuelve 404 y el pipeline degrada en silencio. Verifica despues con:
#     docker compose exec ollama ollama list
# ============================================================================
