# Copia este archivo a .env.dev y rellena los valores.
#     cp .env.example .env.dev
#
# .env.dev esta en .gitignore y NO se sube. Si alguna vez versionaste un secreto
# aqui, rotalo: cambiar el archivo no borra el historial.
#
# La app lee este archivo (app/core/config.py). Variables que no esten, usan su
# valor por defecto.
#
# Docker Compose interpola desde `.env` (tambien gitignored), NO desde .env.dev.
# Por eso la password de abajo va en LOS DOS:
#     cp .env.example .env        # para docker compose
#     cp .env.example .env.dev    # para la app

# --- Base de datos ------------------------------------------------------------
# La leen docker-compose.yml (servicios postgres y api) y la app. Sin ella el
# compose se niega a arrancar con un error explicito, en vez de levantar un
# postgres con una password vacia.
POSTGRES_PASSWORD=CAMBIAR_ESTA_PASSWORD
# Dentro de Docker el host es el nombre del servicio: postgres-reconciler
DATABASE_URL=postgresql+asyncpg://postgres:CAMBIAR_ESTA_PASSWORD@postgres-reconciler:5432/expense_db
# Fuera de Docker (con la BD en tu maquina): localhost:5432

# --- API ----------------------------------------------------------------------
PROJECT_NAME="Expense Reconciler MVP"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Autenticacion (OBLIGATORIO) ---------------------------------------------
# development | production
ENVIRONMENT=development

# Sin esta, en development se genera una clave efimera y TODOS los tokens se
# invalidan en cada reinicio. En production el arranque FALLA a proposito.
# Minimo 32 caracteres. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIAR_ESTA_POR_UNA_LARGA_ALEATORIA_DE_48_CARACTERES

ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- IA ----------------------------------------------------------------------
AI_ENABLED=true

# Ollama (local). Requiere OLLAMA_ENABLED=true y el servicio levantado.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=moondream
OLLAMA_TIMEOUT=600.0

# Proveedor en la nube. Opcionales: si no hay ninguno, el pipeline degrada en
# silencio a "guarda lo parcial" (tickets con importe 0.00 y sin error visible).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Embeddings ---------------------------------------------------------------
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=1536
SIMILARITY_THRESHOLD=0.85

# --- Procesamiento IA ---------------------------------------------------------
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.1

# ============================================================================
# AVISO: si subes OLLAMA_MODEL u OLLAMA_VISION_MODEL a uno que no este descargado,
# Ollama devuelve 404 y el pipeline degrada en silencio. Verifica despues con:
#     docker compose exec ollama ollama list
# ============================================================================
